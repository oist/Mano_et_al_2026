BootStrap: docker
From: nvidia/cuda:11.3.1-cudnn8-devel-ubuntu20.04

%environment
    TZ=Asia/Tokyo
    DEBIAN_FRONTEND=noninteractive

%post
    # to fix timezon info
    export DEBIAN_FRONTEND=noninteractive
    export TZ=Asia/Tokyo

    apt-get update -y
    apt-get install -y --no-install-recommends gcc g++ libgl1 nano wget curl git openssh-client tar gzip ca-certificates
    apt-get install -y build-essential cmake \
    libavcodec-dev libavformat-dev libswscale-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer1.0-dev libgtk-3-dev \
    libpng-dev libjpeg-dev libopenexr-dev libtiff-dev libwebp-dev \
    libopencv-dev x264 libx264-dev libssl-dev ffmpeg

    # install python3.10 amd pip
    apt-get install -y software-properties-common
    add-apt-repository -y ppa:deadsnakes/ppa
    apt-get update -y
    apt-get install -y python3.10
    apt-get install -y python3.10-dev
    curl -sS https://bootstrap.pypa.io/get-pip.py | python3.10
    apt-get clean

    ln -s /usr/bin/python3.10 /usr/bin/python

    python3.10 -m pip install --upgrade setuptools wheel pip

    # install caiman
    cd /opt
    git clone https://github.com/flatironinstitute/CaImAn
    cd CaImAn/
    python3.10 -m pip install --no-binary opencv-python -r requirements.txt
    python3.10 -m pip install .
    #python3.10 caimanmanager.py install

    # additional libraries
    python3.10 -m pip install npTDMS seaborn roifile[all] imagecodecs ipywidgets ipympl


%runscript
    jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --allow-root --notebook-dir=/workdir --NotebookApp.iopub_data_rate_limit=1.0e10
